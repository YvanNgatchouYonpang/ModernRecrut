@model ModernRecrut.MVC.Models.Emplois

@{
    ViewData["Title"] = "Edit";
}

<h1>Modification de l'offre</h1>

<h4>Emploi</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Intitule" class="control-label"></label>
                <input asp-for="Intitule" class="form-control" />
                <span asp-validation-for="Intitule" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateDebutAffichage" class="control-label"></label>
                <input asp-for="DateDebutAffichage" class="form-control" />
                <span asp-validation-for="DateDebutAffichage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateFinAffichage" class="control-label"></label>
                <input asp-for="DateFinAffichage" class="form-control" />
                <span asp-validation-for="DateFinAffichage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
