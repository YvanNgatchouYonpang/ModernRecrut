
@model Favoris

@{
    ViewData["Title"] = "Mes favoris";
}

<div class="container mt-4">

    <h2 class="mb-4">
        <i class="bi bi-heart-fill text-danger"></i>
        Mes emplois favoris
    </h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    @if (Model.ListeEmplois.Any())
    {
        <div class="row">

            @foreach (var emploi in Model.ListeEmplois)
            {
                <div class="col-md-6 mb-3">

                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5 class="card-title">
                                @emploi.Intitule
                            </h5>

                            <p class="text-muted">
                                @emploi.Description
                            </p>

                            <p>
                                <i class="bi bi-calendar"></i>
                                Début :
                                @emploi.DateDebutAffichage.ToString("dd/MM/yyyy")
                            </p>

                            <p>
                                <i class="bi bi-calendar-check"></i>
                                Fin :
                                @emploi.DateFinAffichage.ToString("dd/MM/yyyy")
                            </p>

                            <form asp-action="SupprimerFavori"
                                  method="post">

                                <input type="hidden"
                                       name="emploiId"
                                       value="@emploi.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                    Supprimer
                                </button>
                            </form>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-light text-center p-5">
            <i class="bi bi-heart fs-1 text-danger"></i>

            <h4 class="mt-3">
                Aucun favori pour le moment
            </h4>

            <p>
                Explorez les offres et ajoutez celles
                qui vous intéressent.
            </p>

            <a asp-controller="Emplois"
               asp-action="Index"
               class="btn btn-primary">
                Découvrir les emplois
            </a>
        </div>
    }

</div>
